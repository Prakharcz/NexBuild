# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development

# PostgreSQL Database Configuration
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_password
POSTGRES_DB=finance_db
# For Docker Compose:
DATABASE_URL=postgresql://finance_user:finance_password@postgres:5432/finance_db
# For Local Run without Docker (SQLite fallback is also supported):
# DATABASE_URL=sqlite:///./finance.db

# Redis Cache / Queue Configuration
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For Local Run without Docker:
# REDIS_URL=redis://localhost:6379/0

# Security & JWT Token Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=dev_secret_jwt_key_antigravity_finance_agent_2026_super_secure_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Local LLM (Ollama) Integration
# If Ollama is running locally, the system generates AI insights.
# If Ollama is unavailable, the system automatically falls back to intelligent templates.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Automatic Demo Data Seeding
# Automatically populates realistic 6 months of sample financial data if database is empty
SEED_DEMO_DATA=true

# Frontend Configuration (Used by Vite)
VITE_API_URL=http://localhost:8000/api
